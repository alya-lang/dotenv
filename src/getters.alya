# ═══════════════════════════════════════════════════════════════
# Dotenv Value Accessors & Typed Getters
# ═══════════════════════════════════════════════════════════════

import "std/str"
import "./parser.alya"

# Gets a string value from env_map, or default_val if key not found or empty
pub function get(env_map, key, default_val = "")
    if env_map is not null and has(env_map, key)
        let raw = env_map[key]
        if raw is not null
            let v = str_from_ptr(raw)
            if len(v) > 0
                return v
            end
        end
    end
    return default_val
end

# Gets an integer value from env_map, or default_val
pub function get_int(env_map, key, default_val = 0)
    let val_str = get(env_map, key, "")
    if len(val_str) == 0
        return default_val
    end
    return to_int(val_str)
end

# Gets a boolean value (true, 1, yes, on -> 1; false, 0, no, off -> 0)
pub function get_bool(env_map, key, default_val = 0)
    let val_str = lower(trim(get(env_map, key, "")))
    when val_str
        is "true", "1", "yes", "on" then return 1
        is "false", "0", "no", "off" then return 0
        else return default_val
    end
end

# Gets a float value from env_map, or default_val
pub function get_float(env_map, key, default_val = 0.0)
    let val_str = get(env_map, key, "")
    if len(val_str) == 0
        return default_val
    end
    return to_float(val_str)
end
