## # dotenv/parser
##
## Parser and loader module for dotenv (.env) files.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Supports export statements, quoted values, escape sequences, inline comments,
## and variable interpolation.

import "std/str"
import "std/fs"
import "std/os"
import "./types.alya"

## Checks if a character is ASCII whitespace.
##
## ### Parameters
## - `ch`: Character string.
##
## ### Returns
## `1` if whitespace, `0` otherwise.
pub function is_space_char(ch: string) -> int
    when ch
        is " ", "\t", "\r", "\n" then return 1
        else return 0
    end
end

## Strips quotes and resolves escape sequences for double-quoted values.
##
## ### Parameters
## - `val`: Raw value string.
##
## ### Returns
## Unquoted and unescaped value string.
pub function unquote_value(val: string) -> string
    let vlen = len(val)
    if vlen >= 2
        let first = char_at(val, 0)
        let last = char_at(val, vlen - 1)
        if (first == "\"" and last == "\"") or (first == "'" and last == "'")
            let inner = val[1..(vlen - 1)]
            if first == "\""
                inner = replace(inner, "\\n", "\n")
                inner = replace(inner, "\\t", "\t")
                inner = replace(inner, "\\r", "\r")
                inner = replace(inner, "\\\"", "\"")
                inner = replace(inner, "\\\\", "\\")
            end
            return inner
        end
    end
    return val
end

## Strips unquoted inline comments from a value string (e.g. `FOO=bar # comment`).
##
## ### Parameters
## - `val`: Value string.
##
## ### Returns
## Value with trailing inline comment stripped.
pub function strip_inline_comment(val: string) -> string
    let vlen = len(val)
    if vlen == 0
        return val
    end
    let first = char_at(val, 0)
    if first == "\"" or first == "'"
        return val
    end

    let hash_idx = index_of(val, "#")
    if hash_idx >= 0
        if hash_idx == 0
            return ""
        end
        let prev_ch = char_at(val, hash_idx - 1)
        if is_space_char(prev_ch) == 1
            return trim(val[..hash_idx])
        end
    end
    return val
end

## Checks whether a key exists in an environment map.
##
## ### Parameters
## - `env_map`: Environment variable map.
## - `key`: Variable name key.
##
## ### Returns
## `1` if key is present, `0` otherwise.
pub function has(env_map, key) -> int
    if env_map is null
        return 0
    end
    return key in env_map ? 1 : 0
end

## Expands `${VAR}` variable interpolations using parsed map and OS environment.
##
## ### Parameters
## - `val`: String potentially containing `${VAR}` tokens.
## - `env_map`: Currently parsed environment map.
##
## ### Returns
## Interpolated string value.
pub function interpolate(val: string, env_map) -> string
    return interpolate_with_mode(val, env_map, 1)
end

## Expands `${VAR}` variable references with an explicit InterpolateMode value.
##
## ### Parameters
## - `val`: String potentially containing `${VAR}` tokens.
## - `env_map`: Currently parsed environment map.
## - `mode`: Integer mode (`0` = Disabled, `1` = ProcessEnv, `2` = LocalOnly).
##
## ### Returns
## Interpolated string value.
pub function interpolate_with_mode(val: string, env_map, mode: int) -> string
    if mode == 0
        return val
    end

    let res = val
    while contains(res, "${")
        let start = index_of(res, "${")
        let end_idx = index_of(res, "}")
        if start >= 0 and end_idx > start
            let var_name = res[(start + 2)..end_idx]
            let replacement = ""
            if has(env_map, var_name) == 1
                let raw_val = env_map[var_name]
                replacement = raw_val is not null ? str_from_ptr(raw_val) : ""
            elif mode == 1
                replacement = env(var_name)
            end
            let target = "${" + var_name + "}"
            res = replace(res, target, replacement)
        else
            break
        end
    end
    return res
end

## Parses raw .env string content into a key-value Map using default options.
##
## ### Parameters
## - `content`: Raw `.env` file content string.
##
## ### Returns
## Key-value Map of environment variables.
pub function parse(content) -> map
    return parse_with_options(content, options_new())
end

## Parses raw .env string content into a key-value Map using custom DotenvOptions.
##
## ### Parameters
## - `content`: Raw `.env` file content string.
## - `opts`: Custom `DotenvOptions` instance.
##
## ### Returns
## Key-value Map of environment variables.
pub function parse_with_options(content, opts: DotenvOptions) -> map
    let env_map = map()
    if content is null or len(content) == 0
        return env_map
    end
    let lines = split(content, "\n")
    let interp_mode = opts.interpolate_mode

    for raw_line in lines
        let line = trim(raw_line)

        if ends_with(line, "\r")
            line = line[..(len(line) - 1)]
        end

        # Skip empty lines and comments
        if len(line) == 0 or starts_with(line, "#")
            continue
        end

        # Support 'export KEY=value' syntax
        if starts_with(line, "export ")
            line = trim(line[7..])
        end

        let eq_idx = index_of(line, "=")
        if eq_idx < 1
            continue
        end

        let key = trim(line[..eq_idx])
        let val = trim(line[(eq_idx + 1)..])

        val = strip_inline_comment(val)
        val = unquote_value(val)
        val = interpolate_with_mode(val, env_map, interp_mode)

        env_map[key] = val
    end

    return env_map
end

## Loads and parses a specific environment file from disk.
##
## ### Parameters
## - `path`: File system path to `.env` file.
##
## ### Returns
## Key-value Map of parsed environment variables.
pub function load_file(path: string) -> map
    if fs_exists(path) == 0
        return map()
    end
    let content = fs_read(path)
    return parse(content)
end

## Loads and parses a specific environment file from disk with custom DotenvOptions.
##
## ### Parameters
## - `path`: File system path to `.env` file.
## - `opts`: Custom `DotenvOptions` instance.
##
## ### Returns
## Key-value Map of parsed environment variables.
pub function load_file_with_options(path: string, opts: DotenvOptions) -> map
    if fs_exists(path) == 0
        return map()
    end
    let content = fs_read(path)
    return parse_with_options(content, opts)
end

## Loads .env from current working directory, falling back to .env.local.
##
## ### Returns
## Key-value Map of parsed environment variables.
pub function load() -> map
    if fs_exists(".env")
        return load_file(".env")
    elif fs_exists(".env.local")
        return load_file(".env.local")
    end
    return map()
end

## Loads .env from current working directory with custom DotenvOptions.
##
## ### Parameters
## - `opts`: Custom `DotenvOptions` instance.
##
## ### Returns
## Key-value Map of parsed environment variables.
pub function load_with_options(opts: DotenvOptions) -> map
    if fs_exists(".env")
        return load_file_with_options(".env", opts)
    elif fs_exists(".env.local")
        return load_file_with_options(".env.local", opts)
    end
    return map()
end
