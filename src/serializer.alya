# ═══════════════════════════════════════════════════════════════
# Dotenv Serializer Module
# ═══════════════════════════════════════════════════════════════

import "std/str"

pub enum QuoteMode
    Auto = 0,
    Always = 1,
    Never = 2
end

# Serializes an env_map back to .env format string
pub function dump(env_map)
    if env_map is null
        return ""
    end
    let out = ""
    for k, raw in env_map
        let v = raw is not null ? str_from_ptr(raw) : ""
        if contains(v, " ") or contains(v, "#") or contains(v, "\n")
            out += k + "=\"" + v + "\"\n"
        else
            out += k + "=" + v + "\n"
        end
    end
    return out
end
