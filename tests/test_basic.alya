# ═══════════════════════════════════════════════════════════════
# Alya Dotenv Test Suite
# ═══════════════════════════════════════════════════════════════

import "std/test"
import "std/fs"
import "../src/lib.alya" as dotenv

function test_basic_parsing(r)
    let sample = """
# Configuration for Alya App
APP_NAME=AlyaEngine
PORT=8080
DEBUG=true
RATIO=3.1415
EMPTY_VAL=

# Export syntax
export DB_HOST=localhost
export DB_PORT=5432
"""
    let m = dotenv::parse(sample)

    runner_assert_str_eq(r, dotenv::get(m, "APP_NAME"), "AlyaEngine", "parse basic string")
    runner_assert_eq(r, dotenv::get_int(m, "PORT"), 8080, "parse integer")
    runner_assert_eq(r, dotenv::get_bool(m, "DEBUG"), 1, "parse boolean true")
    runner_assert(r, dotenv::get_float(m, "RATIO") > 3.0, "parse float")
    runner_assert_str_eq(r, dotenv::get(m, "EMPTY_VAL", "default"), "default", "fallback default on empty")
    runner_assert_str_eq(r, dotenv::get(m, "DB_HOST"), "localhost", "export keyword parsing")
    runner_assert_eq(r, dotenv::has(m, "APP_NAME"), 1, "has key check")
    runner_assert_eq(r, dotenv::has(m, "NON_EXISTENT"), 0, "has missing key check")
end

function test_quotes_and_comments(r)
    let sample = """
# Comment line
QUOTED_DOUBLE="Hello World"
QUOTED_SINGLE='Plain String # not a comment'
INLINE_COMMENT=ValueWithoutQuotes # this is a comment
WITH_HASH="Contains # inside quotes"
"""
    let m = dotenv::parse(sample)

    runner_assert_str_eq(r, dotenv::get(m, "QUOTED_DOUBLE"), "Hello World", "double quotes stripped")
    runner_assert_str_eq(r, dotenv::get(m, "QUOTED_SINGLE"), "Plain String # not a comment", "single quotes preserved without comment strip")
    runner_assert_str_eq(r, dotenv::get(m, "INLINE_COMMENT"), "ValueWithoutQuotes", "inline comment stripped")
    runner_assert_str_eq(r, dotenv::get(m, "WITH_HASH"), "Contains # inside quotes", "hash preserved inside double quotes")
end

function test_interpolation(r)
    let sample = """
HOST=127.0.0.1
PORT=9000
API_URL="http://${{HOST}}:${{PORT}}/v1"
"""
    let m = dotenv::parse(sample)

    runner_assert_str_eq(r, dotenv::get(m, "API_URL"), "http://127.0.0.1:9000/v1", "variable interpolation")
end

function test_file_operations(r)
    let test_file = "test_temp.env"
    let sample = "ENV_KEY=TempSavedVal\nENV_INT=42\n"
    fs_write(test_file, sample)

    let m = dotenv::load_file(test_file)
    runner_assert_str_eq(r, dotenv::get(m, "ENV_KEY"), "TempSavedVal", "load_file reads disk file")
    runner_assert_eq(r, dotenv::get_int(m, "ENV_INT"), 42, "load_file parses int")

    if fs_exists(test_file)
        fs_remove(test_file)
    end
end

function main()
    test_suite("Alya Dotenv Package Test Suite")
    let r = runner_new()

    test_basic_parsing(r)
    test_quotes_and_comments(r)
    test_interpolation(r)
    test_file_operations(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
